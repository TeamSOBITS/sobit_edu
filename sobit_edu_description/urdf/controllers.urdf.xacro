<?xml version="1.0" encoding="UTF-8" ?>
<!-- SOBIT EDU (Dynamixel Control) -->
<robot name="sobit_edu_controllers" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="controllers" params="name enable_gz:=False robot_name:=sobit_edu">

    <ros2_control name="${name}_arm" type="system">
    <!-- <ros2_control name="joints_control" type="system"> -->
      <hardware>
        <xacro:if value="${$(arg enable_gz)}">
          <plugin>ign_ros2_control/IgnitionSystem</plugin>
          <!-- <plugin>gazebo_ros2_control/GazeboHardware</plugin> -->
        </xacro:if>
        <xacro:unless value="${$(arg enable_gz)}">
          <xacro:property name="dxl_se_port" value="$(arg dxl_se_port)"/>
          <plugin>dynamixel_hardware/DynamixelHardware</plugin>
          <param name="port_name">${dxl_se_port}</param>
          <param name="baud_rate">1000000</param>
          <!-- <param name="use_dummy">true</param> -->
        </xacro:unless>
      </hardware>

      <!-- Position Drive: Arm -->
      <joint name="arm_shoulder_roll_joint">
        <xacro:unless value="${$(arg enable_gz)}">
          <param name="id">10</param>
          <param name="control_mode">0</param>
          <param name="interface">rs</param>
        </xacro:unless>
        <command_interface name="position">
          <param name="min">-3.141592654</param>
          <param name="max">3.141592654</param>
        </command_interface>
        <!-- <command_interface name="velocity"/> -->
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="arm_shoulder_pitch_sub_joint">
        <xacro:unless value="${$(arg enable_gz)}">
          <param name="id">12</param>
          <param name="control_mode">0</param>
          <param name="interface">rs</param>
        </xacro:unless>
        <!-- <param name="mimic">arm_shoulder_pitch_joint</param>
        <param name="multiplier">-1</param> -->
        <!-- <command_interface name="position"/> -->
        <command_interface name="position">
          <param name="min">-2.356194490192345</param>
          <param name="max">1.570796327</param>
        </command_interface>
        <!-- <command_interface name="velocity"/> -->
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <!-- <state_interface name="position"/> -->
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="arm_shoulder_pitch_joint">
        <xacro:unless value="${$(arg enable_gz)}">
          <param name="id">11</param>
          <param name="control_mode">0</param>
          <param name="interface">rs</param>
        </xacro:unless>
        <command_interface name="position">
          <param name="min">-1.570796327</param>
          <param name="max">2.356194490192345</param>
        </command_interface>
        <!-- <command_interface name="velocity"/> -->
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="arm_elbow_pitch_joint">
        <xacro:unless value="${$(arg enable_gz)}">
          <param name="id">13</param>
          <param name="control_mode">0</param>
          <param name="interface">rs</param>
        </xacro:unless>
        <command_interface name="position">
          <param name="min">-1.570796327</param>
          <param name="max">1.570796327</param>
        </command_interface>
        <!-- <command_interface name="velocity"/> -->
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="arm_forearm_roll_joint">
        <xacro:unless value="${$(arg enable_gz)}">
          <param name="id">14</param>
          <param name="control_mode">0</param>
          <param name="interface">rs</param>
        </xacro:unless>
        <command_interface name="position">
          <param name="min">-3.141592654</param>
          <param name="max">3.141592654</param>
        </command_interface>
        <!-- <command_interface name="velocity"/> -->
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="arm_wrist_pitch_joint">
        <xacro:unless value="${$(arg enable_gz)}">
          <param name="id">15</param>
          <param name="control_mode">0</param>
          <param name="interface">rs</param>
        </xacro:unless>
        <command_interface name="position">
          <param name="min">-1.570796327</param>
          <param name="max">1.570796327</param>
        </command_interface>
        <!-- <command_interface name="velocity"/> -->
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="arm_wrist_roll_joint">
        <xacro:unless value="${$(arg enable_gz)}">
          <param name="id">16</param>
          <param name="control_mode">0</param>
          <param name="interface">rs</param>
        </xacro:unless>
        <command_interface name="position">
          <param name="min">-3.141592654</param>
          <param name="max">3.141592654</param>
        </command_interface>
        <!-- <command_interface name="velocity"/> -->
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>

      <!-- Position Drive: Hand -->
      <joint name="hand_joint">
        <xacro:unless value="${$(arg enable_gz)}">
          <param name="id">17</param>
          <param name="control_mode">6</param>
          <param name="Goal_Current">50</param>
          <param name="interface">rs</param>
          <param name="gear_ratio">-59.504383354</param>
        </xacro:unless>
        <command_interface name="position"/>
        <!-- <command_interface name="velocity"/> -->
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <xacro:if value="${$(arg enable_gz)}">
        <joint name="hand_sub_joint">
          <param name="mimic">hand_joint</param>
          <param name="multiplier">-1</param>
          <command_interface name="position"/>
          <!-- <command_interface name="velocity"/> -->
          <state_interface name="position"/>
          <state_interface name="velocity"/>
          <state_interface name="effort"/>
        </joint>
      </xacro:if>


      <!-- Position Drive: Head -->
      <joint name="head_camera_pan_joint">
        <xacro:unless value="${$(arg enable_gz)}">
          <param name="id">21</param>
          <param name="control_mode">0</param>
          <param name="interface">rs</param>
        </xacro:unless>
        <command_interface name="position">
          <param name="min">-3.141592654</param>
          <param name="max">3.141592654</param>
        </command_interface>
        <!-- <command_interface name="velocity"/> -->
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>

      <joint name="head_camera_tilt_joint">
        <xacro:unless value="${$(arg enable_gz)}">
          <param name="id">22</param>
          <param name="control_mode">0</param>
          <param name="interface">rs</param>
        </xacro:unless>
        <command_interface name="position">
          <param name="min">-1.570796327</param>
          <param name="max">1.570796327</param>
        </command_interface>
        <!-- <command_interface name="velocity"/> -->
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
    </ros2_control>

    <!-- Differential Drive -->
    <xacro:if value="${$(arg enable_gz)}">
      <ros2_control name="${name}_base" type="system">
        <hardware>
          <plugin>ign_ros2_control/IgnitionSystem</plugin>
          <!-- <plugin>gazebo_ros2_control/GazeboHardware</plugin> -->
        </hardware>

        <joint name="wheel_l_joint">
          <command_interface name="velocity">
            <param name="min">-1.0</param>
            <param name="max">1.0</param>
          </command_interface>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
        </joint>
        
        <joint name="wheel_r_joint">
          <command_interface name="velocity">
            <param name="min">-1.0</param>
            <param name="max">1.0</param>
          </command_interface>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
        </joint>
      </ros2_control>

      <gazebo reference="plate_bottom_link">
        <mu1>0.0</mu1>
        <mu2>0.0</mu2>
      </gazebo>
    </xacro:if>


    <!-- Ignition ROS2 Control -->
    <xacro:if value="${$(arg enable_gz)}">
      <gazebo>
        <!-- <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin"> -->
        <plugin filename="ign_ros2_control-system" name="ign_ros2_control::IgnitionROS2ControlPlugin">
          <ros>
            <namespace>${robot_name}</namespace>
          </ros>
          <parameters>$(find sobit_edu_control)/config/controllers_gz.yaml</parameters>
        </plugin>
      </gazebo>
    </xacro:if>

  </xacro:macro>

</robot>